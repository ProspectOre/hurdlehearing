  "banned": [
    [
      "gold",
      "paper",
      "gold is never text on light ground (about 2.3:1)"
    ],
    [
      "gold-bright",
      "paper",
      "gold-bright is never text on light ground"
    ],
    [
      "ink",
      "gold",
      "gold is not a text ground: ink on gold reads Lc 54, below the bold-button floor of 60"
    ],
    [
      "sea",
      "ink",
      "sea fails as text on the dark band; use sea-tint"
    ],
    [
      "gold",
      "paper",
      "gold is not a lone boundary or icon on paper (under 3:1); pair with an ink or gold-text hairline"
    ]
  ],
  "separability": {
    "note": "brand fills must stay distinct under every simulation; text tokens carry meaning by words and underlines, never hue",
